# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model for Milo
OPENAI_MODEL=gpt-5.4-mini

# Neon Database URL
POSTGRES_URL=your_neon_postgres_url_here

# Resend API Key for Email Notifications
RESEND_API_KEY=your_resend_api_key_here

# Optional: Cron Secret for securing the daily digest endpoint
CRON_SECRET=your_random_secret_key_here

# Optional: Base URL for links in emails
NEXT_PUBLIC_BASE_URL=https://archpointlabs.com

# Optional: production verification helpers
CHAT_PROD_BASE_URL=https://archpointlabs.com
GITHUB_REPOSITORY=Archpoint-Labs/archpointlabs
VERCEL_PROJECT_NAME=archpointlabs
VERCEL_SCOPE=your-vercel-team-or-user-slug
VERCEL_TOKEN=your_vercel_token_for_log_scans
